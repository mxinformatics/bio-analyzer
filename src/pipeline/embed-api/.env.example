# Copy this file to .env and adjust values for your environment.
# embed-api

# ---------------------------
# API security
# ---------------------------
REQUIRE_API_KEY=false
EMBEDDING_API_KEY=

# ---------------------------
# Shared pipeline storage
# ---------------------------
# Required
AZURE_STORAGE_ACCOUNT=bioanalyzerpoc
AZURE_STORAGE_CHUNKS_CONTAINER=extractedtext
AZURE_STORAGE_EMBEDDING_CONTAINER=embeddedchunks
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ---------------------------
# Embedding runtime (Azure OpenAI / Foundry)
# ---------------------------
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=1
MAX_CHUNKS_PER_REQUEST=25000
# Required
FOUNDRY_AI_ENDPOINT=
FOUNDRY_AI_EMBEDDING_DEPLOYMENT=
# Authentication:
# - embed-api uses DefaultAzureCredential token auth only
# - set AZURE_MANAGED_IDENTITY_CLIENT_ID when using user-assigned identity
