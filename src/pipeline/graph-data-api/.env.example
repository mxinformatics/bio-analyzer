# Copy this file to .env and adjust values for your environment.
# graph-data-api

# ---------------------------
# API security
# ---------------------------
REQUIRE_API_KEY=false
GRAPH_DATA_API_KEY=

# ---------------------------
# Shared pipeline storage
# ---------------------------
# Required
AZURE_STORAGE_ACCOUNT=bioanalyzerpoc
AZURE_STORAGE_EMBEDDING_CONTAINER=embeddedchunks
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ---------------------------
# Neo4j backend (required)
# ---------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=bio
NEO4J_VECTOR_INDEX=bio_embedding_index
NEO4J_TEXT_INDEX=bio_text_index
NEO4J_VECTOR_DIMENSIONS=1532
# Required Key Vault source for Neo4j credentials
KEY_VAULT_URL=
NEO4J_USERNAME_SECRET_NAME=GraphDatabase--Username
NEO4J_PASSWORD_SECRET_NAME=GraphDatabase--Password

# ---------------------------
# Query embedding + hybrid ranking
# ---------------------------
GRAPH_QUERY_ALPHA=0.7
DEFAULT_TOP_K=5
MAX_QUERY_RESULTS=100
# Required
FOUNDRY_AI_ENDPOINT=https://aif-mxinfo-bioanalyzer-poc-eus.services.ai.azure.com/
FOUNDRY_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOUNDRY_AI_CHAT_DEPLOYMENT=gpt-5.4-nano
TOPIC_EXTRACTION_MAX_CHUNKS=12
TOPIC_EXTRACTION_MAX_CHUNK_CHARS=1200
TOPIC_EXTRACTION_MAX_TOPICS=12
# Authentication:
# - graph-data-api uses DefaultAzureCredential token auth only
# - set AZURE_MANAGED_IDENTITY_CLIENT_ID when using user-assigned identity
