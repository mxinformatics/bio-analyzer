# BioAnalyzer Research API connection (local Aspire / launchSettings default)
RESEARCH_API_BASE_URL=http://localhost:5179

# Development API key (matches BioAnalyzer.Research.Api appsettings.Development.json)
RESEARCH_API_KEY=local-dev-research-api-key

# Optional: prefer Entra bearer token over API key when set
# RESEARCH_API_BEARER_TOKEN=

# Optional overrides
# RESEARCH_API_KEY_HEADER=X-Api-Key
# RESEARCH_API_TIMEOUT_SECONDS=60
