@page "/chat"
@rendermode InteractiveServer

<PageTitle>Chat</PageTitle>

<section class="page-section">
    <h1 class="page-title">Chat</h1>

    <div class="mb-3">
        <label for="chatQuery" class="form-label">Question</label>
        <InputText id="chatQuery" class="form-control" @bind-Value="Query" placeholder="Ask a research question" />
    </div>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-primary" @onclick="StartStreamAsync" disabled="@_isStreaming">Start Stream</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="StopStream" disabled="@(!_isStreaming)">Stop</button>
        <button type="button" class="btn btn-outline-danger" @onclick="ClearOutput">Clear</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="card">
        <div class="card-header">Token Stream</div>
        <div class="card-body" style="min-height: 200px; white-space: pre-wrap;">
            @if (string.IsNullOrEmpty(ResponseText))
            {
                <span class="text-muted">No tokens yet.</span>
            }
            else
            {
                @ResponseText
            }
        </div>
    </div>
</section>

