{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiAuthentication": {
    "Enabled": true,
    "ApiKey": "",
    "HeaderName": "X-Api-Key",
    "BypassWhenApiKeyMissingInDevelopment": true
  },
  "ResearchApi": {
    "EntrezBaseUrl": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
    "NcbiBaseUrl": "https://pmc.ncbi.nlm.nih.gov/api/oai/v1/mh/",
    "EntrezTool": "BioAnalyzer",
    "EntrezEmail": "",
    "EntrezApiKey": ""
  },
  "ResearchStorage": {
    "BlobStorageUrl": "https://bioanalyzerpoc.blob.core.windows.net",
    "TableStorageUrl": "https://bioanalyzerpoc.table.core.windows.net",
    "DownloadTableName": "DownloadedLiterature",
    "RetrievalMetricsTableName": "GraphRetrievalEvaluation",
    "IngestJobTableName": "LiteratureIngestJobs",
    "DownloadContainerName": "literature"
  },
  "Events": {
    "ServiceBusNamespace": "mxinfo-bioanalyzer-poc-eus.servicebus.windows.net",
    "LiteratureDownloadTopic": "download-document-request"
  },
  "SecureConfiguration": {
    "UseKeyVault": true,
    "ExcludeEnvironmentCredential": true,
    "KeyVaultUrl": "https://kv-mxinfo-bioanalyze-poc.vault.azure.net/",
    "IdentityClientId": ""
  },
  "LiteratureExpansion": {
    "Enabled": true,
    "AutoIngestEnabled": true,
    "MaxCandidates": 3,
    "SearchRetMax": 20,
    "MaxConcurrentLinkResolutions": 4,
    "RequirePmcId": true,
    "RequireOpenAccessLink": true,
    "MaxIngestJobsPerRequesterPerDay": 20,
    "RequireIdempotencyKey": true,
    "RestrictJobStatusToRequester": true,
    "QueryPreviewMaxLength": 220,
    "RequireRequesterIdentity": true,
    "AllowAnonymousRequester": false
  },
  "OpenAiConfiguration": {
    "Endpoint": "https://aif-mxinfo-bioanalyzer-poc-eus.services.ai.azure.com/models",
    "GptName": "gpt-5.4-nano",
    "GraphApiUrl": "http://localhost:8080",
    "GraphApiKey": "",
    "GraphTopK": 5,
    "GraphQueryTimeoutSeconds": 30,
    "GraphMaxRetryAttempts": 3,
    "GraphInitialBackoffMilliseconds": 250,
    "GraphCircuitBreakerFailureThreshold": 5,
    "GraphCircuitBreakerBreakSeconds": 60,
    "GraphEvidenceMinScore": 0.25,
    "GraphMinEvidenceCount": 1,
    "GraphMaxEvidenceCount": 8,
    "GraphRequireCitationsInResponse": true
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": "",
    "Domain": ""
  }
}
