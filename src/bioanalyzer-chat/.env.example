AZURE_AD_CLIENT_ID=your_azure_ad_client_id_here
AZURE_AD_TENANT_ID=your_azure_ad_tenant_id_here
AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret_here

NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000

# Microsoft Foundry resource endpoint, e.g. https://mxinfo-bioanalyzer.services.ai.azure.com
# Authentication uses DefaultAzureCredential (no API key) — sign in locally with
# `az login`, or supply AZURE_CLIENT_ID/AZURE_TENANT_ID/AZURE_CLIENT_SECRET for a
# service principal / managed identity in deployed environments.
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
AZURE_FOUNDRY_DEPLOYMENT=gpt-4.1
AZURE_TOP_SEARCH_RESULTS=3

AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0.1


NODE_TLS_REJECT_UNAUTHORIZED=0

# Phase 1 agentic chat (tool-calling). When true/1/on, /api/chat uses Foundry + tools
# (askGraph first). When false/unset, proxies Research API /Chat/stream (legacy).
AGENTIC_CHAT_ENABLED=true
# Optional override for Azure OpenAI API version used by the agent model.
# AZURE_FOUNDRY_API_VERSION=2024-12-01-preview


# Phase 4 close-the-loop wait policy after requestLiteratureIngest.
# defer (default): check status once and ask user to retry if still pending.
# poll: short exponential backoff polls before re-querying the graph.
INGEST_WAIT_MODE=defer
# INGEST_POLL_MAX_ATTEMPTS=5
# INGEST_POLL_INITIAL_DELAY_MS=5000
# INGEST_POLL_MAX_DELAY_MS=15000


# Phase 5 interim abstract answers while full-text ingest runs.
# When true (default), agent may call buildInterimAbstractBriefing after candidates.
INTERIM_ABSTRACTS_ENABLED=true
# INTERIM_ABSTRACTS_MAX=2


# Phase 6 feature flags
# EXPANSION_TOOLS_ENABLED=false disables candidate/search/ingest tools (askGraph only).
EXPANSION_TOOLS_ENABLED=true
# AUTO_INGEST_ENABLED=false keeps discovery + interim abstracts but hides ingest tools.
AUTO_INGEST_ENABLED=true
# Optional stable requester identity forwarded as X-Requester-Id for quotas/authz.
# Prefer session user from NextAuth when present; this is a dev override only.
# AGENT_REQUESTER_ID=local-dev-user

# Shared Research.Api service credential (Phase B). Must match ApiAuthentication:ApiKey.
# Aspire AppHost injects RESEARCH_API_KEY; set manually for standalone next dev.
RESEARCH_API_KEY=local-dev-research-api-key

# Entra delegated scope for Research.Api (from terraform output research_api_scope).
# Example: api://bioanalyzer-research-api-poc/access_as_user
RESEARCH_API_SCOPE=api://bioanalyzer-research-api-poc/access_as_user

# Phase C2: expose agent tool downloadFile (blob by name). Default off — App UI HTTP download remains.
# AGENT_BLOB_DOWNLOAD_TOOL_ENABLED=true
